# Where the site lives — used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.kristalytakaritas.hu

# --- Contact form delivery (set at least one) -------------------------------
# Email via Resend (https://resend.com). The sender must be on a domain you
# have verified there.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Weboldal <weboldal@kristalytakaritas.hu>
# Where enquiries go. Defaults to EMAIL in src/lib/site.ts.
CONTACT_TO_EMAIL=

# Or / also: any endpoint that accepts a JSON POST (CRM, Make, Zapier…).
CONTACT_WEBHOOK_URL=
