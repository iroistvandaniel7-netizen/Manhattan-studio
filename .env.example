# Where contact form submissions are delivered (any endpoint accepting a JSON POST).
# Unset in production, the form refuses to report success and shows the phone
# numbers instead. See README → "Contact form delivery".
CONTACT_WEBHOOK_URL=

# Where shop orders are delivered while Stripe is not connected. Falls back to
# CONTACT_WEBHOOK_URL when unset. See README → "The shop".
ORDER_WEBHOOK_URL=

# --- Online payment -------------------------------------------------------
# Set both of these and the shop takes card payments. With only the first set,
# payments work but the studio is never told what was bought — checkout warns
# and delivers orders as unpaid instead. Set both, or neither.
#
# STRIPE_SECRET_KEY      Dashboard → Developers → API keys (sk_live_… / sk_test_…)
# STRIPE_WEBHOOK_SECRET  Dashboard → Developers → Webhooks → your endpoint (whsec_…)
#                        Point that endpoint at  https://your-site/api/stripe/webhook
#                        and subscribe it to  checkout.session.completed  and
#                        checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The URL Stripe returns customers to. Without it the site guesses from the
# request, which is wrong behind a proxy.
NEXT_PUBLIC_SITE_URL=

# Test only: points the checkout at a stand-in Stripe. Never set in production.
# STRIPE_API_BASE=
